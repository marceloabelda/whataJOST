{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating-bar-window",
  "description": "Allow the floating monitoring bar to query monitoring status",
  "windows": ["floating-bar"],
  "permissions": [
    "core:default",
    "core:window:allow-outer-position",
    "core:window:allow-set-position",
    "allow-whatsapp-ipc"
  ]
}
