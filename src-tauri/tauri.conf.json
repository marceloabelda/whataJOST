{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whataJOST",
  "version": "1.2.14",
  "identifier": "com.whatajost.app",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "linux": {
      "deb": {
        "depends": ["xclip", "wl-clipboard", "fonts-noto-color-emoji"],
        "files": {
          "/usr/share/applications/whatajost-url-handler.desktop": "../public/whatajost-url-handler.desktop"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NzI5NjgyRUE0NjFGRjcKUldUM0gwYnFncFp5cHd2bzFsdzFrdERSUitpWGZqNFdCSFo3K1FaZHBvV0pnVnhOTkJNc1VkcWkK",
      "endpoints": [
        "https://github.com/marceloabelda/whataJOST/releases/latest/download/latest.json"
      ]
    }
  }
}
